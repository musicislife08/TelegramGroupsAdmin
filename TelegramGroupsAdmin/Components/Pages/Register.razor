@page "/register"
@using System.Text.Json
@using TelegramGroupsAdmin.Services
@inject InternalApiClient InternalApiClient
@inject IAuthService AuthService
@inject IFeatureAvailabilityService FeatureAvailability
@inject NavigationManager Navigation
@inject ILogger<Register> Logger
@inject IDialogService DialogService
@attribute [AllowAnonymous]

<PageTitle>Register - Telegram Groups Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="4" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            @(_isFirstRun ? "Setup Owner Account" : "Create Account")
        </MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            @(_isFirstRun ? "Create the initial administrator account" : "Register with your invite code")
        </MudText>

        @if (_isFirstRun)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                No users exist. The first account will be created with Owner permissions.
            </MudAlert>

            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudText Typo="Typo.body2" Class="mb-2">
                    <strong>Have a backup?</strong> You can restore from a previous backup instead of creating a new account.
                </MudText>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                           OnClick="@OpenRestoreModal">
                    Restore from Backup
                </MudButton>
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (_registrationSuccess)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                @(_successMessage ?? "Account created successfully! You can now log in.")
            </MudAlert>
            @if (_verificationRequired)
            {
                @* The user has to act on the message (check their inbox), so it stays on screen; they leave via this link. *@
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mb-4">
                    Go to login
                </MudButton>
            }
        }

        @* Until the first-run and email state are resolved the defaults below are placeholders: render neither
           the note nor the invite field, so the page never flashes a note or a field that then disappears. *@
        @if (RegistrationUnavailable)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudText Typo="Typo.body2">
                    <strong>Note:</strong> Registration is temporarily unavailable: the server could not determine its
                    email service configuration. Please try again later or contact your administrator.
                </MudText>
            </MudAlert>
        }
        else if (_stateResolved && !_isFirstRun && _emailState == EmailConfigurationState.Disabled)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                <MudText Typo="Typo.body2">
                    <strong>Note:</strong> Email verification is currently disabled (email service not configured).
                    You will be able to log in immediately after registration. If you cannot log in, contact your administrator.
                </MudText>
            </MudAlert>
        }

        @if (_stateResolved && !_isFirstRun)
        {
            <MudTextField T="string"
                          Label="Invite Code"
                          @bind-Value="_inviteToken"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Disabled="@FormDisabled" />
        }

        <MudTextField T="string"
                      Label="Email"
                      @bind-Value="_email"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      InputType="InputType.Email"
                      Disabled="@FormDisabled" />

        <MudTextField T="string"
                      Label="Password"
                      @bind-Value="_password"
                      Variant="Variant.Outlined"
                      Class="mb-4"
                      InputType="InputType.Password"
                      Disabled="@FormDisabled"
                      HelperText="Minimum 8 characters with uppercase, lowercase, and number"
                      Validation="@(new Func<string, string?>(ValidatePassword))"
                      Immediate="true" />

        <MudTextField T="string"
                      Label="Confirm Password"
                      @bind-Value="_confirmPassword"
                      Variant="Variant.Outlined"
                      Class="mb-6"
                      InputType="InputType.Password"
                      Disabled="@FormDisabled"
                      Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                      Immediate="true" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="@(async () => await HandleRegisterAsync())"
                   Disabled="@FormDisabled">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Creating Account...</MudText>
            }
            else
            {
                <span>Create Account</span>
            }
        </MudButton>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Already have an account?
            <MudLink Href="/login" Color="Color.Primary">Sign In</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private bool _isLoading;
    private bool _registrationSuccess;
    // Set from the register endpoint: the account starts unverified and a verification email went out, so the
    // page keeps its instruction on screen instead of auto-redirecting to login.
    private bool _verificationRequired;
    private bool _isFirstRun;
    private bool _stateResolved;
    // Strict state so the note matches what the register endpoint will do: Indeterminate means AuthService
    // refuses registration (fail closed), so the page must not promise an immediate login.
    private EmailConfigurationState _emailState = EmailConfigurationState.Enabled;
    private string _inviteToken = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty; // Initialized as empty, never null
    private string _confirmPassword = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;

    // The register endpoint refuses every attempt while the email state is Indeterminate (fail closed), so the
    // form stays disabled under the "temporarily unavailable" note rather than inviting a doomed submit.
    private bool RegistrationUnavailable => _stateResolved && _emailState == EmailConfigurationState.Indeterminate;
    private bool FormDisabled => _isLoading || _registrationSuccess || RegistrationUnavailable;

    [SupplyParameterFromQuery(Name = "invite")]
    private string? InviteQueryParam { get; set; }

    private string? ValidatePassword(string password)
    {
        if (string.IsNullOrEmpty(password))
            return "Password is required";

        if (password.Length < 8)
            return "Password must be at least 8 characters";

        if (!password.Any(char.IsUpper))
            return "Password must contain at least one uppercase letter";

        if (!password.Any(char.IsLower))
            return "Password must contain at least one lowercase letter";

        if (!password.Any(char.IsDigit))
            return "Password must contain at least one number";

        return null;
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (string.IsNullOrEmpty(confirmPassword))
            return "Please confirm your password";

        if (confirmPassword != _password)
            return "Passwords do not match";

        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        _isFirstRun = await AuthService.IsFirstRunAsync();
        _emailState = await FeatureAvailability.GetEmailConfigurationStateAsync();
        _stateResolved = true;

        if (!string.IsNullOrEmpty(InviteQueryParam))
        {
            _inviteToken = InviteQueryParam;
        }
    }

    private async Task OpenRestoreModal()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<RestoreBackupModal>("Restore from Backup", options);
    }

    private async Task HandleRegisterAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // Validate password is not null (form validation should prevent this)
            if (string.IsNullOrEmpty(_password))
            {
                _errorMessage = "Password is required";
                _isLoading = false;
                StateHasChanged();
                return;
            }

            var response = await InternalApiClient.CreateClient().PostAsJsonAsync("/api/auth/register", new
            {
                Email = _email,
                Password = _password, // Already initialized as empty string, never null
                InviteToken = _inviteToken
            });

            // Check if response has content and is JSON
            if (!response.IsSuccessStatusCode || response.Content.Headers.ContentLength == 0)
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrEmpty(errorBody)
                    ? $"Server error: {response.StatusCode}"
                    : "Registration failed. Please check the server logs for details.";
                Logger.LogError("Registration failed with status {StatusCode}: {Body}", response.StatusCode, errorBody);
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<JsonElement>();

            if (result.ValueKind == JsonValueKind.Undefined || !result.GetProperty("success").GetBoolean())
            {
                _errorMessage = result.ValueKind != JsonValueKind.Undefined && result.TryGetProperty("error", out var error)
                    ? error.GetString()
                    : "Registration failed";
                return;
            }

            // Registration successful - show the message
            // The login flow handles all verification: email, TOTP setup, TOTP verify
            _successMessage = result.TryGetProperty("message", out var msg)
                ? msg.GetString()
                : "Account created successfully! Please log in.";
            _verificationRequired = result.TryGetProperty("verificationRequired", out var verificationRequired)
                && verificationRequired.ValueKind == JsonValueKind.True;
            _registrationSuccess = true;
            StateHasChanged();

            if (_verificationRequired)
            {
                // The user must verify before logging in: leave the instruction on screen with the "Go to login" link.
                return;
            }

            // Wait for user to see the success message
            await Task.Delay(2000);

            // Redirect to login - no auto-login
            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = "An error occurred during registration. Please try again.";
            Logger.LogError(ex, "Unexpected error during registration for email {Email}", _email);
            _registrationSuccess = false;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
