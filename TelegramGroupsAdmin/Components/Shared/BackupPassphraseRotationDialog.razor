@using TelegramGroupsAdmin.BackgroundJobs.Constants
@using TelegramGroupsAdmin.BackgroundJobs.Services.Backup
@inject IPassphraseManagementService PassphraseService
@inject IBackupRotationService RotationService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="mr-2" />
            Rotate Backup Passphrase
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_step == RotationStep.Scanning)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-3" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Checking existing backups...
                </MudText>
            }
            else if (_step == RotationStep.Repair)
            {
                @if (_wrappedFiles.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <strong>@_wrappedFiles.Count @(_wrappedFiles.Count == 1 ? "backup was" : "backups were") damaged by a passphrase rotation in an earlier version.</strong><br/>
                        They can be repaired with the passphrase that was in use before your first rotation.
                        Try each passphrase you have used; every backup a passphrase opens is repaired.
                    </MudAlert>

                    <MudTextField @bind-Value="_repairPassphrase"
                                  Label="@RepairPassphraseLabel"
                                  HelperText="The passphrase in use before your first rotation"
                                  Variant="Variant.Outlined"
                                  InputType="@RepairInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@RepairVisibilityIcon"
                                  OnAdornmentClick="ToggleRepairVisibility"
                                  Immediate="true"
                                  FullWidth="true" />

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Build"
                               OnClick="@RepairAsync"
                               Disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_repairPassphrase))">
                        Repair
                    </MudButton>

                    @if (_lastRepairedCount is { } repaired)
                    {
                        <MudText Typo="Typo.body2">
                            Repaired @repaired. Still locked: @_wrappedFiles.Count.
                        </MudText>
                    }

                    <MudText Typo="Typo.subtitle2">Damaged backups</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                        @foreach (var file in _wrappedFiles)
                        {
                            @file<br/>
                        }
                    </MudText>
                }

                @if (_unreadableFiles.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        <strong>Can't be read (will block rotation)</strong>
                    </MudAlert>
                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                        @foreach (var file in _unreadableFiles)
                        {
                            @file<br/>
                        }
                    </MudText>
                }

                <MudAlert Severity="Severity.Info" Dense="true">
                    Backups you can't repair can be deleted, or left in place. The rotation skips damaged
                    backups, but they stay unusable without the passphrase they were made with.
                </MudAlert>

                <MudCheckBox @bind-Value="_confirmDelete" Color="Color.Error" Dense="true">
                    I understand these backups will be permanently deleted
                </MudCheckBox>

                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="@DeleteDamagedAsync"
                           Disabled="@(!_confirmDelete || _isProcessing)"
                           FullWidth="true">
                    Delete these @DamagedFiles.Count backups
                </MudButton>
            }
            else if (_step == RotationStep.Confirmation)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    <strong>What will happen:</strong><br/>
                    A new @(_useCustomPassphrase ? "custom" : "auto-generated") passphrase will be used and all existing backups in @BackupDirectory will be re-encrypted.
                    This may take several minutes depending on the number of backups.
                </MudAlert>

                <MudAlert Severity="Severity.Info" Dense="true">
                    <strong>Why rotate?</strong><br/>
                    Regular passphrase rotation is a security best practice. If you suspect your passphrase has been compromised, rotate immediately.
                </MudAlert>

                <MudExpansionPanels Gutters="false" Dense="true">
                    <MudExpansionPanel Text="Advanced Options" Dense="true">
                        <MudStack Spacing="2" Class="mt-2">
                            <MudSwitch @bind-Value="_useCustomPassphrase"
                                       Color="Color.Primary"
                                       Label="Use custom passphrase (instead of auto-generated)" />

                            @if (_useCustomPassphrase)
                            {
                                <MudTextField @bind-Value="_customPassphrase"
                                              Label="Custom Passphrase"
                                              HelperText="@($"Minimum {EncryptionConstants.MinimumPassphraseLengthChars} characters recommended. Use a strong, unique passphrase.")"
                                              Variant="Variant.Outlined"
                                              InputType="@PassphraseInputType"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@PassphraseVisibilityIcon"
                                              OnAdornmentClick="TogglePassphraseVisibility"
                                              Immediate="true"
                                              FullWidth="true" />

                                @if (!string.IsNullOrWhiteSpace(_customPassphrase) && _customPassphrase.Length < EncryptionConstants.MinimumPassphraseLengthChars)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-0">
                                        Passphrase is too short. Recommend at least @EncryptionConstants.MinimumPassphraseLengthChars characters for security.
                                    </MudAlert>
                                }
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <MudCheckBox @bind-Value="_understood" Color="Color.Primary" Dense="true">
                    I understand this will re-encrypt all existing backups
                </MudCheckBox>
            }
            else if (_step == RotationStep.Processing)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-3" />
                <MudText Typo="Typo.body1" Align="Align.Center">
                    Rotating passphrase and re-encrypting backups...
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    This may take a few minutes. Do not close this dialog.
                </MudText>
            }
            else if (_step == RotationStep.DisplayNewPassphrase)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    <strong>Rotation Complete!</strong><br/>
                    A background job is re-encrypting your backups. Copy this NEW passphrase and store it securely.
                </MudAlert>

                <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Your NEW Backup Encryption Passphrase:</MudText>
                    <MudText Typo="Typo.body1" Style="font-family: monospace; word-break: break-all; user-select: all;">
                        <strong>@_newPassphrase</strong>
                    </MudText>
                </MudPaper>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@CopyPassphraseToClipboard"
                           FullWidth="true">
                    Copy to Clipboard
                </MudButton>

                <MudAlert Severity="Severity.Error" Dense="true">
                    <strong>Save this passphrase now!</strong><br/>
                    You will need it to restore backups. The old passphrase will no longer work once re-encryption completes.
                </MudAlert>

                <MudCheckBox @bind-Value="_confirmSaved" Color="Color.Error" Dense="true">
                    I have securely saved this NEW passphrase
                </MudCheckBox>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_step == RotationStep.Repair)
        {
            <MudButton OnClick="@OnCancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@ContinueToConfirmation"
                       Disabled="@_isProcessing">
                Continue without them
            </MudButton>
        }
        else if (_step == RotationStep.Confirmation)
        {
            <MudButton OnClick="@OnCancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@StartRotation"
                       Disabled="@(!_understood || _isProcessing || (_useCustomPassphrase && string.IsNullOrWhiteSpace(_customPassphrase)))">
                @if (_isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Starting...</span>
                }
                else
                {
                    <span>@(_useCustomPassphrase ? "Set Custom Passphrase" : "Generate New Passphrase")</span>
                }
            </MudButton>
        }
        else if (_step == RotationStep.Processing)
        {
            <MudButton Disabled="true">Please wait...</MudButton>
        }
        else if (_step == RotationStep.DisplayNewPassphrase)
        {
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="@OnComplete"
                       Disabled="@(!_confirmSaved || _isProcessing)">
                @if (_isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Starting Rotation...</span>
                }
                else
                {
                    <span>I've Saved It - Start Rotation</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [CascadingParameter] private WebUserIdentity? WebUser { get; set; }
    [Parameter] public string BackupDirectory { get; set; } = "/data/backups";

    private const string RepairPassphraseLabel = "Original passphrase";

    private enum RotationStep
    {
        Scanning,
        Repair,
        Confirmation,
        Processing,
        DisplayNewPassphrase
    }

    private RotationStep _step = RotationStep.Scanning;
    private bool _understood;
    private bool _confirmSaved;
    private bool _isProcessing;
    private string _newPassphrase = string.Empty;
    private string _userId = string.Empty;
    private bool _useCustomPassphrase;
    private string _customPassphrase = string.Empty;
    private bool _showCustomPassphrase;

    private List<string> _wrappedFiles = [];
    private List<string> _unreadableFiles = [];
    private string _repairPassphrase = string.Empty;
    private bool _showRepairPassphrase;
    private int? _lastRepairedCount;
    private bool _confirmDelete;

    private List<string> DamagedFiles => [.. _wrappedFiles, .. _unreadableFiles];
    private InputType RepairInputType => _showRepairPassphrase ? InputType.Text : InputType.Password;
    private string RepairVisibilityIcon => _showRepairPassphrase ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private void ToggleRepairVisibility() => _showRepairPassphrase = !_showRepairPassphrase;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var scan = await RotationService.ScanAsync(BackupDirectory);
            _wrappedFiles = [.. scan.WrappedFiles];
            _unreadableFiles = [.. scan.UnreadableFiles];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not check existing backups: {ex.Message}", Severity.Warning);
        }

        _step = DamagedFiles.Count > 0 ? RotationStep.Repair : RotationStep.Confirmation;
    }

    private async Task RepairAsync()
    {
        if (WebUser is null)
        {
            Snackbar.Add("Your session could not be verified. Please sign in again.", Severity.Error);
            return;
        }

        _isProcessing = true;
        try
        {
            var result = await RotationService.RepairWrappedAsync(BackupDirectory, _repairPassphrase, WebUser.Id);
            _lastRepairedCount = result.RepairedCount;
            _wrappedFiles = [.. result.StillWrappedFiles];
            _repairPassphrase = string.Empty;

            if (DamagedFiles.Count == 0)
            {
                Snackbar.Add($"Repaired {result.RepairedCount} damaged backup(s).", Severity.Success);
                _step = RotationStep.Confirmation;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Repair failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeleteDamagedAsync()
    {
        if (WebUser is null)
        {
            Snackbar.Add("Your session could not be verified. Please sign in again.", Severity.Error);
            return;
        }

        _isProcessing = true;
        try
        {
            var deleted = await RotationService.DeleteDamagedAsync(BackupDirectory, DamagedFiles, WebUser.Id);
            Snackbar.Add($"Deleted {deleted} damaged backup(s).", Severity.Success);
            _wrappedFiles = [];
            _unreadableFiles = [];
            _step = RotationStep.Confirmation;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ContinueToConfirmation() => _step = RotationStep.Confirmation;

    private InputType PassphraseInputType => _showCustomPassphrase ? InputType.Text : InputType.Password;
    private string PassphraseVisibilityIcon => _showCustomPassphrase ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;

    private void TogglePassphraseVisibility() => _showCustomPassphrase = !_showCustomPassphrase;

    private async Task StartRotation()
    {
        _isProcessing = true;
        StateHasChanged();

        try
        {
            if (WebUser is null)
            {
                Snackbar.Add("Your session could not be verified. Please sign in again.", Severity.Error);
                _isProcessing = false;
                return;
            }
            _userId = WebUser.Id;

            // Use custom passphrase if provided, otherwise generate (but DON'T queue job yet!)
            if (_useCustomPassphrase)
            {
                if (string.IsNullOrWhiteSpace(_customPassphrase))
                {
                    Snackbar.Add("Custom passphrase cannot be empty!", Severity.Error);
                    _step = RotationStep.Confirmation;
                    return;
                }
                _newPassphrase = _customPassphrase.Trim();
            }
            else
            {
                _newPassphrase = Core.Security.PassphraseGenerator.Generate();
            }

            // Move to display step - user MUST save passphrase before job starts
            _step = RotationStep.DisplayNewPassphrase;
            Snackbar.Add("New passphrase ready. Please save it securely before confirming!", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to prepare passphrase: {ex.Message}", Severity.Error);
            _step = RotationStep.Confirmation;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task CopyPassphraseToClipboard()
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _newPassphrase);
            Snackbar.Add("Passphrase copied to clipboard!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to copy: {ex.Message}. Please copy manually.", Severity.Warning);
        }
    }

    private void OnCancel()
    {
        MudDialog.Cancel();
    }

    private async Task OnComplete()
    {
        if (!_confirmSaved)
        {
            Snackbar.Add("Please confirm you've saved the passphrase before continuing!", Severity.Warning);
            return;
        }

        _isProcessing = true;
        _step = RotationStep.Processing;
        StateHasChanged();

        try
        {
            // NOW queue the background job to re-encrypt backups
            await PassphraseService.RotatePassphraseAsync(_newPassphrase, BackupDirectory, _userId);

            Snackbar.Add("Passphrase rotation started! Background job is re-encrypting your backups.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_newPassphrase));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to start rotation: {ex.Message}", Severity.Error);
            _step = RotationStep.DisplayNewPassphrase;
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }
}
