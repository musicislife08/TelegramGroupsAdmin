{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-test-data-rules.sh\"",
            "timeout": 10,
            "statusMessage": "Checking test-data rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet slopwatch analyze -d \"$CLAUDE_PROJECT_DIR\" --hook",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
