<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- EF1002: ExecuteSqlRawAsync SQL injection warning - SQL here is composed in code from canonical identifiers, never from test input -->
    <!-- slopwatch-ignore: SW005 EF1002 flags ExecuteSqlRaw with composed SQL; statements are composed from canonical table/column identifiers in code (never test input); values go through {n} parameters -->
    <NoWarn>$(NoWarn);EF1002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TelegramGroupsAdmin.Data\TelegramGroupsAdmin.Data.csproj" />
    <ProjectReference Include="..\TelegramGroupsAdmin.Core\TelegramGroupsAdmin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical SQL fixtures (canonical/*.sql is FK-ordered by filename prefix) plus the
         plaintext fixtures for encrypted columns (canonical/*.json, protected at load time). -->
    <EmbeddedResource Include="SQL\**\*.sql;SQL\**\*.json" Exclude="SQL\tools\**" />
  </ItemGroup>

</Project>
